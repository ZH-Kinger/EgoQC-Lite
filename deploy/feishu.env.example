# Copy this file to /srv/egoqc/secrets/feishu.env on the server.
# Never commit or paste the real app secret into chat or source control.
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=replace_me
FEISHU_REDIRECT_URI=https://review.example.com/auth/callback

# Optional: comma-separated tenant keys. When set, users from other tenants are rejected.
FEISHU_ALLOWED_TENANT_KEYS=

# Login session lifetime, in seconds. Default: 12 hours; maximum enforced: 7 days.
EGOQC_SESSION_TTL_SECONDS=43200
