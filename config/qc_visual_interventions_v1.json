{
  "schema_version": "egoqc-visual-interventions-v1",
  "status": "train_only_synthetic_not_gold",
  "families": {
    "gaussian_blur": {"required_capability": "raw_rgb", "target_tasks": ["unusable_visual_quality"], "parameters": {"sigma": 3.0}},
    "exposure_shift": {"required_capability": "raw_rgb", "target_tasks": ["unusable_visual_quality"], "parameters": {"gamma": 2.4}},
    "jpeg_recompression": {"required_capability": "raw_rgb", "target_tasks": ["unusable_visual_quality"], "parameters": {"quality": 18}},
    "frame_freeze": {"required_capability": "raw_rgb", "target_tasks": ["frozen_or_duplicate_frames"], "parameters": {"fraction": 0.5}},
    "temporal_drop": {"required_capability": "raw_rgb", "target_tasks": ["interaction_incomplete"], "parameters": {"fraction": 0.35}},
    "boundary_shift": {"required_capability": "raw_rgb", "target_tasks": ["subtask_boundary_error"], "parameters": {"fraction": 0.3}},
    "homography_jitter": {"required_capability": "raw_rgb", "target_tasks": ["semantic_camera_shake"], "parameters": {"maximum_pixels": 28}},
    "radial_distortion": {"required_capability": "raw_rgb", "target_tasks": ["severe_lens_artifact"], "parameters": {"k1": 0.32}},
    "central_occlusion": {"required_capability": "raw_rgb", "target_tasks": ["severe_occlusion", "action_not_observable"], "parameters": {"width_fraction": 0.42, "height_fraction": 0.42}},
    "task_text_swap": {"required_capability": "task_text", "target_tasks": ["task_label_mismatch"], "parameters": {"different_primitive_required": true}},
    "overlay_translation": {"required_capability": "mano_overlay", "target_tasks": ["mano_overlay_drift"], "parameters": {"x_pixels": 48, "y_pixels": -32}}
  },
  "real_only_tasks": [
    "hand_absent",
    "persistent_extra_hands",
    "scene_task_out_of_scope"
  ],
  "capability_required_tasks": {"mano_overlay_drift": "mano_overlay"},
  "governance": {
    "allowed_split": "train",
    "lazy_on_cached_frames": true,
    "raw_source_readonly": true,
    "synthetic_is_not_gold": true,
    "may_authorize_accept_or_reject": false
  }
}
