{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/egoqc/generic-ego-sidecar-v1.schema.json",
  "title": "Optional metadata sidecar for a generic egocentric video",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "task": {"type": "string"},
    "task_label": {"type": "string"},
    "description": {"type": "string"},
    "activities": {"type": ["array", "string"]},
    "subtasks": {"type": "array"},
    "supplier_id": {"type": "string"},
    "person_id": {"type": "string"},
    "operator_id": {"type": "string"},
    "collection_session_id": {"type": "string"},
    "session_id": {"type": "string"},
    "scene_id": {"type": "string"},
    "camera_id": {"type": "string"},
    "task_id": {"type": "string"},
    "intrinsics": {"type": ["array", "object"]},
    "distortion": {"type": ["array", "object"]},
    "camera_trajectory": {"type": ["array", "object", "string"]},
    "hand_2d_keypoints": {"type": ["array", "object", "string"]},
    "hand_boxes": {"type": ["array", "object", "string"]},
    "hand_joint_transforms": {"type": ["array", "object", "string"]},
    "mano": {"type": ["array", "object", "string"]},
    "depth_path": {"type": "string"},
    "imu_path": {"type": "string"},
    "sensor_timestamps": {"type": ["array", "object", "string"]},
    "hand_ground_truth": {"type": "boolean"},
    "trajectory_ground_truth": {"type": "boolean"},
    "capabilities": {"type": "object", "additionalProperties": {"type": "boolean"}}
  }
}
